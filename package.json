{
  "name": "jhtml",
  "version": "0.7.1",
  "author": {
    "name": "Brett Zamir",
    "email": "brettz9@yahoo.com",
    "url": "http://brett-zamir.me"
  },
  "contributors": [],
  "type": "module",
  "types": "./dist/jhtml.d.cts",
  "main": "./dist/jhtml.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/jhtml-browser.d.ts",
        "import": "./dist/jhtml-browser-esm.mjs",
        "require": "./dist/jhtml-browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/jhtml-node.d.mts",
          "default": "./dist/jhtml-node-esm.mjs"
        },
        "require": {
          "types": "./dist/jhtml-node.d.cts",
          "default": "./dist/jhtml-node.js"
        }
      },
      "default": {
        "import": {
          "types": "./dist/jhtml.d.mts",
          "default": "./dist/jhtml-esm.mjs"
        },
        "require": {
          "types": "./dist/jhtml.d.cts",
          "default": "./dist/jhtml.js"
        }
      }
    },
    "./jhtml.js": {
      "import": {
        "types": "./dist/jhtml.d.mts",
        "default": "./dist/jhtml-esm.mjs"
      },
      "require": {
        "types": "./dist/jhtml.d.cts",
        "default": "./dist/jhtml.js"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm i && pnpm rollup && pnpm attw",
    "attw": "attw --pack . --profile node16",
    "tsc": "tsc",
    "start": "static -p 8005",
    "eslint": "eslint --ext=js,html,md .",
    "lint": "npm run eslint",
    "rollup": "rm -Rf dist && rollup -c && echo '{\"type\": \"commonjs\"}' > dist/package.json && tsc -p tsconfig-prod.json",
    "mocha": "mocha",
    "test": "c8 npm run mocha"
  },
  "browserslist": [
    "last 2 chrome versions"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@node-static/node-static": "^0.9.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "baseline-browser-mapping": "^2.11.19",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "css.escape": "^1.5.1",
    "eslint": "^10.9.1",
    "eslint-config-ash-nazg": "^42.6.0",
    "mocha": "^11.8.0",
    "rollup": "^4.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "homepage": "https://github.com/brettz9/jhtml",
  "description": "The JHTML format is a strict subset of HTML used to encode arbitrary JSON within HTML. This library seeks to provide conversions while simultaneously validating the indicated JHTML structure(s).",
  "repository": {
    "type": "git",
    "url": "https://github.com/brettz9/jhtml.git"
  },
  "keywords": [
    "json",
    "html"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/jhtml/issues"
  },
  "dependencies": {
    "jsdom": "^30.0.1"
  }
}
